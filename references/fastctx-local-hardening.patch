+        let native_home = std::path::PathBuf::from("native-home");
+        let selected = preferred_home(Some(git_home.clone()), Some(native_home.clone()));
+        #[cfg(windows)]
+        assert_eq!(selected, Some(native_home));
+        #[cfg(not(windows))]
